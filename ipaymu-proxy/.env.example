# Proxy Server Config
PORT=3000
NODE_ENV=production

# Security: Shared secret between iStore (Vercel) and this Proxy (VPS)
# Generate a strong token: openssl rand -hex 32
PROXY_AUTH_TOKEN=your_secure_proxy_token_here

# iPaymu Credentials (Static IP Whitelisted in iPaymu Dashboard)
IPAYMU_VA=your_ipaymu_va
IPAYMU_API_KEY=your_ipaymu_api_key
IPAYMU_BASE_URL=https://my.ipaymu.com/api/v2
